SOURCE_DATABASE_URL=postgresql://<readonly_user>:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
ANALYTICS_DB_PATH=data/analytics.duckdb
INTERNAL_USER_IDS=
INTERNAL_EMAIL_DOMAINS=
TZ_OFFSET_MINUTES=330

# Friction Finder
# LLM judge (Claude). Two ways to pay for it:
#  - subscription: install Claude Code (`claude`), run it once and log in with your Claude Pro/Max account. No key needed.
#  - api: set ANTHROPIC_API_KEY (billed per token).
# auto = API key if set, else Claude Code login if the CLI is found, else rules-only.
FRICTION_LLM_PROVIDER=auto
# Optional: full path to the claude CLI if it isn't on PATH
CLAUDE_CLI_PATH=
ANTHROPIC_API_KEY=
# auto = use the judge when a key is set | on | off
FRICTION_USE_LLM=auto
# HH:MM (IST). While the server runs, sync + analyse yesterday's chats daily at this time. Empty = manual only.
FRICTION_DAILY_AT=

# Hosted deployments (Render): set a password to put the whole site behind a browser login. Empty = no login.
BASIC_AUTH_USER=bookr
BASIC_AUTH_PASSWORD=
