SOURCE_DATABASE_URL=postgresql://<readonly_user>:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Bookr Analyst's own Postgres database on Neon: the masked analytics copy (schema `analyst`) and the
# Friction Finder store (schema `friction`). Use the same value locally and on Render to share one database.
# Must NOT be the Bookkr source database above. The login needs CREATE on the database.
ANALYST_DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# Optional: only copy rows on/after this local date ("YYYY-MM-DD" or "YYYY-MM-DD HH:MM"). Empty = all history.
SYNC_SINCE=
INTERNAL_USER_IDS=
INTERNAL_EMAIL_DOMAINS=
TZ_OFFSET_MINUTES=330

# Friction Finder
# LLM judge (Claude). Two ways to pay for it:
#  - subscription: install Claude Code (`claude`), run it once and log in with your Claude Pro/Max account. No key needed.
#  - api: set ANTHROPIC_API_KEY (billed per token).
# auto = API key if set, else Claude Code login if the CLI is found, else rules-only.
FRICTION_LLM_PROVIDER=auto
# Optional: full path to the claude CLI if it isn't on PATH
CLAUDE_CLI_PATH=
ANTHROPIC_API_KEY=
# auto = use the judge when a key is set | on | off
FRICTION_USE_LLM=auto
# HH:MM (IST). While the server runs, sync + analyse yesterday's chats daily at this time. Empty = manual only.
FRICTION_DAILY_AT=

# Hosted deployments (Render): set a password to put the whole site behind a browser login. Empty = no login.
BASIC_AUTH_USER=bookr
BASIC_AUTH_PASSWORD=

# Quality › Operations service checks (optional; each service reads NOT SET UP until its value is set).
# The same names the old ops board used. Keys are only sent to their own service and never shown on the page.
BACKEND_URL=
REDIS_URL=
TRAVEL_GATEWAY_BASE_URL=
TRAVEL_GATEWAY_JWT_SECRET=
TRAVEL_GATEWAY_JWT_ISSUER=
PAYMENTS_SERVICE_URL=
SERP_API_KEY=
SEARCH_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
