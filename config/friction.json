{
  "_readme": "Friction Finder rules. Edit and restart the server (or re-run the CLI). Team rules R1/R1a live in TRACKER.md.",

  "mandatory_fields": {
    "_note": "R1: Bookkr must collect these before moving on. The agent ASKING for one of them (even again) is never friction. Inferred from the assistant's slot questions in test data. CONFIRM WITH TEAM (TRACKER Q1).",
    "flight": ["origin", "destination", "departure_date", "return_date (round trip only)", "passengers"],
    "hotel": ["destination", "check_in", "check_out", "guests"],
    "trip_plan": ["destination", "travel_dates_or_month", "trip_duration", "travelling_with", "origin"]
  },

  "ask_patterns": {
    "_note": "Regexes (case-insensitive) that recognise an assistant question as asking for a field. A field marked mandatory:true is excluded from friction by rule R1.",
    "origin":              {"mandatory": true,  "patterns": ["departure city", "departing from", "depart(ing)? from", "which city will you be depart", "where (are|will) you (be )?(flying|travell?ing) from", "from which city"]},
    "destination":         {"mandatory": true,  "patterns": ["your destination", "destination (and|city|country)", "where would you like to go", "where (are|do) you (want to )?(go|travel)", "which city .* (visit|go)"]},
    "departure_date":      {"mandatory": true,  "patterns": ["travel dates?", "what dates?", "departure date", "when (would|do) you (like to )?(travel|fly|leave)", "which date", "future dates?"]},
    "return_date":         {"mandatory": true,  "patterns": ["return date", "return month", "when .* return"]},
    "passengers":          {"mandatory": true,  "patterns": ["who you'?re travell?ing with", "how many (of you|people|passengers|travell?ers|adults)", "travell?ing with", "number of (passengers|travell?ers)"]},
    "trip_duration":       {"mandatory": true,  "patterns": ["trip duration", "how many (days|nights)", "how long"]},
    "check_in":            {"mandatory": true,  "patterns": ["check-?in", "stay dates"]},
    "check_out":           {"mandatory": true,  "patterns": ["check-?out"]},
    "guests":              {"mandatory": true,  "patterns": ["how many guests", "number of guests", "how many rooms"]},
    "confirmation":        {"mandatory": true,  "patterns": ["here is what i have so far", "would you like to proceed", "shall i (search|proceed|go ahead)", "would you like me to (search|book|show)"]},
    "cabin":               {"mandatory": false, "patterns": ["cabin class", "which class", "economy or business"]},
    "budget":              {"mandatory": false, "patterns": ["your budget", "budget (range|per)", "how much .* spend"]},
    "time_of_day":         {"mandatory": false, "patterns": ["morning or evening", "preferred (time|departure time)"]},
    "interests":           {"mandatory": false, "patterns": ["your interests", "travel style", "what kind of (trip|experience)"]}
  },

  "quick_reply_patterns": {
    "_note": "Button / chip replies. Never counted as the user repeating themselves.",
    "patterns": ["^yes\\b", "^(ok|okay|sure|confirm|go ahead|proceed)\\b", "^find (flights|stays|hotels) for option", "^search (flights|hotels)", "^yes, search", "^show (me )?(more|flights|hotels)", "^(book|select) (this|option)"]
  },

  "correction_markers": {
    "strong": ["\\bi (said|meant|told you)\\b", "\\bwrong\\b", "\\bactually\\b", "\\bincorrect\\b", "\\bthat'?s not\\b", "\\bnot what i\\b", "\\binstead\\b", "\\bgalat\\b", "\\bmaine (bola|kaha)\\b", "\\bmistake\\b", "\\bagain\\b"],
    "weak": ["^no\\b", "\\bnope\\b", "\\bnahi?n?\\b", "\\bnot\\b", "\\bchange\\b"]
  },

  "_r8": "R8: each rule signal belongs to a bucket (technical | intent | suggestion). Types, owners and fix lanes live in backend/bookr_analyst/friction/taxonomy.py.",
  "technical_error_patterns": ["something went wrong", "unable to (search|load|complete|process)", "can'?t search", "try again (later|in a)", "technical (issue|problem|error)", "temporarily unavailable"],
  "no_results_patterns": ["could not find", "couldn'?t find", "no (flights|hotels|results|stays|options) (found|available)"],
  "past_date_patterns": ["appear to be in the past", "dates? (is|are) in the past", "already passed"],
  "product_gap_patterns": ["coming soon", "(don'?t|do not|can'?t|cannot) (yet )?(book|support|offer) (cabs?|taxis?|trains?|buses|bus|activities)", "not (available|supported) yet"],

  "weights": {
    "repeated_info": 2,
    "correction_strong": 2,
    "correction_weak": 1,
    "edit_after_confirm": 1,
    "repeat_search": 1,
    "bad_search_params": 2,
    "search_mismatch": 1.5,
    "intent_drift": 2,
    "could_not_find": 1,
    "past_date": 1,
    "negative_feedback": 3,
    "long_slot_filling": 1,
    "nonmandatory_reask": 1,
    "app_error": 2,
    "provider_failure": 2,
    "llm_failure": 2,
    "latency": 1,
    "payment_booking_failure": 3,
    "fare_expired": 1,
    "price_changed": 1,
    "product_gap": 1,
    "changed_filters": 0.5
  },

  "thresholds": {
    "_note": "flag_min_score: a chat becomes a finding (rules-only mode). judge_min_score: a chat is sent to the LLM judge (LLM mode).",
    "flag_min_score": 2,
    "judge_min_score": 1,
    "repeat_min_overlap_tokens": 2,
    "repeat_min_overlap_ratio": 0.5,
    "long_slot_filling_user_msgs": 4,
    "slow_reply_s": 40,
    "llm_fallback_window_s": 20,
    "_finetune": "Q13 default: an RAG cluster (same owner + type) with this many agreed items is flagged as a fine-tune candidate.",
    "finetune_cluster_min": 20
  },

  "llm": {
    "model": "claude-sonnet-5-5",
    "effort": "medium",
    "concurrency": 4,
    "subscription_model": "claude-sonnet-5-5",
    "subscription_concurrency": 2,
    "subscription_timeout_s": 300,
    "max_sessions_per_run": 400,
    "max_known_false_positives_in_prompt": 25
  },

  "exclude_internal_users": true
}
